PORT=3000
NODE_ENV=development
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
# Required unless NODE_ENV is development or test (unset NODE_ENV counts as production).
# REDIS_PASSWORD=
# all = API + workers in one process | api = dispatch only | worker = jobs only
APP_ROLE=all
WORKER_PORT=3001
QUEUE_CONCURRENCY=2
SHUTDOWN_TIMEOUT_MS=30000

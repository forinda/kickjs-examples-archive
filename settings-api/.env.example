# Generated by `kick env example` from the env schema and the declared settings
# sections. Re-run it after changing them; `kick env example --check` fails when stale.
#
# Uncommented variables are required. Commented ones are optional; the value shown
# is the default. Any variable can come from a file instead: NAME_FILE=/run/secrets/name

# ── App env schema ──
# PORT=3000
# NODE_ENV=development
# LOG_LEVEL=info

# ── APP settings (declared by app) ──
# Display name
# APP_NAME=settings-api
# Where clients reach this API (links in emails)
APP_PUBLIC_URL=

# ── TRANSACTIONAL_MAIL settings (declared by adapter MailAdapter:transactional) ──
# SMTP host
# TRANSACTIONAL_MAIL_HOST=localhost
# TRANSACTIONAL_MAIL_PORT=1025
# SMTP user
# TRANSACTIONAL_MAIL_USER=
# SMTP password — or <NAME>_FILE pointing at a mounted secret
TRANSACTIONAL_MAIL_PASSWORD=
# Sender address
TRANSACTIONAL_MAIL_FROM=

# ── MARKETING_MAIL settings (declared by adapter MailAdapter:marketing) ──
# SMTP host
# MARKETING_MAIL_HOST=localhost
# MARKETING_MAIL_PORT=1025
# SMTP user
# MARKETING_MAIL_USER=
# SMTP password — or <NAME>_FILE pointing at a mounted secret
MARKETING_MAIL_PASSWORD=
# Sender address
MARKETING_MAIL_FROM=

# ── FEATURES settings (declared by module Object) ──
# Accept new sign-ups
# FEATURES_SIGNUPS=true
# Show the beta banner to everyone
# FEATURES_BETA_BANNER=false
# FEATURES_MAX_UPLOAD_MB=10
# Always see the beta banner — comma-separated list
# FEATURES_BETA_TESTERS=

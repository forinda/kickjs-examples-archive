{
  "name": "kickjs-example-inertia-app",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "kick dev",
    "build": "kick build && vite build --config vite.client.config.ts && vite build --config vite.client.config.ts --ssr src/client/ssr.tsx",
    "start": "kick start",
    "test": "vitest run",
    "typecheck": "kick typecheck",
    "lint": "oxlint src/",
    "format": "oxfmt src/",
    "db:generate": "kick db generate",
    "db:migrate": "kick db migrate latest",
    "db:status": "kick db migrate status"
  },
  "dependencies": {
    "@forinda/kickjs": "^10.3.1",
    "@forinda/kickjs-db": "^8.7.0",
    "@forinda/kickjs-devtools": "^7.11.0",
    "@forinda/kickjs-inertia": "^0.2.0",
    "@forinda/kickjs-schema": "^0.2.4",
    "@inertiajs/core": "^3.9.1",
    "@inertiajs/react": "^3.9.1",
    "better-sqlite3": "^13.0.3",
    "dotenv": "^17.4.2",
    "express": "^5.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "reflect-metadata": "^0.2.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@forinda/kickjs-cli": "^8.10.2",
    "@forinda/kickjs-testing": "^8.3.0",
    "@forinda/kickjs-vite": "^8.0.2",
    "@swc/core": "^1.16.18",
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "^6.1.2",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.88.0",
    "supertest": "^7.3.1",
    "typescript": "^7.0.2",
    "unplugin-swc": "^2.0.0",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "allowScripts": {
    "@swc/core": true,
    "esbuild": true,
    "better-sqlite3": true
  },
  "packageManager": "pnpm@11.24.0"
}

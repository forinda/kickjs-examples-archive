PORT=3000
NODE_ENV=development
# Signs the session cookie (flash messages, validation errors).
# Required unless NODE_ENV is development or test (32+ chars): openssl rand -hex 32
# Left unset in development/test, a dev-only default is used.
# SESSION_SECRET=
# SQLite file (created on first run). ':memory:' gives a throwaway database.
DB_FILE=data/app.db
# Apply pending migrations at startup outside development/test (one instance; the Docker image sets it).
# MIGRATE_ON_BOOT=false

PORT=3000
NODE_ENV=development
# disk (default in development/test) | s3 (default otherwise)
# STORAGE_DRIVER=disk
UPLOAD_DIR=uploads
MAX_UPLOAD_BYTES=5242880
# Required unless NODE_ENV is development or test (32+ chars each): openssl rand -hex 32
# Left unset under development/test, dev-only defaults are used.
# API_KEY=
# SIGNING_SECRET=
# Base of signed download URLs (disk driver). Default: the request's Host.
# PUBLIC_URL=https://files.example.com
# S3-compatible bucket, read when STORAGE_DRIVER=s3 (validated at startup)
# S3_BUCKET=files
# S3_REGION=us-east-1
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_ENDPOINT=http://localhost:9000

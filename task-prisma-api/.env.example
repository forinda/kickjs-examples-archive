PORT=3000
NODE_ENV=development

# Postgres (matches the docker command in README.md)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/vibed

# JWT — required, 32+ chars each, no defaults: openssl rand -hex 32
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# App
APP_URL=http://localhost:3000
APP_NAME=Vibed

# Redis (BullMQ queues)
REDIS_URL=redis://localhost:6379

# Mail — leave SMTP_URL empty to log mail to the console
SMTP_URL=
MAIL_FROM_NAME=Vibed
MAIL_FROM_EMAIL=noreply@vibed.dev

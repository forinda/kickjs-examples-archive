NODE_ENV=development
PORT=3000

MONGODB_URI=mongodb://localhost:27017/vibed
REDIS_URL=redis://localhost:6379

# Required when NODE_ENV=production (32+ chars each): openssl rand -hex 32
# Left unset in development, dev-only defaults are used.
# JWT_SECRET=
# JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Mail: development logs to the console; production sends through Resend and requires the key.
# RESEND_API_KEY=
MAIL_FROM_NAME=Vibed
MAIL_FROM_EMAIL=noreply@vibed.app

APP_URL=http://localhost:3000
APP_NAME=Vibed

NODE_ENV=development
PORT=3000

MONGODB_URI=mongodb://localhost:27017/vibed
REDIS_URL=redis://localhost:6379

# Required unless NODE_ENV is development or test (32+ chars): openssl rand -hex 32
# Left unset under development/test, a dev-only default is used.
# JWT_SECRET=
JWT_ACCESS_EXPIRES_IN=15m

# Mail: development/test log to the console; otherwise mail goes through Resend and the key is required.
# RESEND_API_KEY=
MAIL_FROM_NAME=Vibed
MAIL_FROM_EMAIL=noreply@vibed.app

PORT=3000
NODE_ENV=development
# Signs chat tokens (32+ chars): openssl rand -hex 32. Required unless NODE_ENV is development or test.
# Left unset under development/test, a dev-only default is used.
# CHAT_SECRET=
# Share rooms and presence between instances. Unset = single process.
# REDIS_URL=redis://localhost:6379
# Heartbeat ping interval in ms (0 disables).
WS_HEARTBEAT_MS=30000

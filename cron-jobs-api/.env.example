PORT=3000
NODE_ENV=development
CRON_ENABLED=true
# Comma-separated job names to skip, e.g. nightly-report,warm-cache
CRON_DISABLED_JOBS=
# Required unless NODE_ENV is development or test (16+ chars): openssl rand -hex 32
# Enables GET /_kick/cron/:scheduleId (serverless) and POST /api/v1/cron/jobs/:name/run.
# CRON_SECRET=
INVENTORY_SYNC_MS=3000

PORT=3000
NODE_ENV=development

# Postgres (matches the docker command in README.md)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/task_drizzle

# JWT — required, no defaults. Generate each with: openssl rand -hex 32
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

APP_URL=http://localhost:3000
APP_NAME=Vibed

# Redis (BullMQ queues)
REDIS_URL=redis://localhost:6379

# Mail — SMTP transport URL; empty logs mail to the console (required outside development/test)
SMTP_URL=
MAIL_FROM_NAME=Vibed
MAIL_FROM_EMAIL=noreply@vibed.dev
